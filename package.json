{
  "name": "motion-studio",
  "productName": "모션스튜디오",
  "version": "1.0.1",
  "private": true,
  "description": "디자이너용 대화형 모션 영상 제작 도구",
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "setup": "node scripts/setup.mjs",
    "binaries": "node scripts/fetch-binaries.mjs",
    "registry": "node scripts/fetch-registry.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:mac-x64": "node scripts/build-mac.mjs --arch x64",
    "dist:mac-arm64": "node scripts/build-mac.mjs --arch arm64",
    "dist:mac-local-build": "node scripts/build-mac.mjs --local --no-install",
    "dist:mac-local": "node scripts/build-mac.mjs --local",
    "dist:win": "npm run build && node scripts/fetch-registry.mjs && node scripts/prepare-target.mjs --target win32-x64 && node scripts/fetch-binaries.mjs --target win32-x64 && electron-builder --config electron-builder.config.cjs --win --x64",
    "test:e2e": "npm run build && node tests/e2e/smoke.mjs",
    "test:live": "npm run build && node tests/e2e/live-flow.mjs",
    "pack:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "dist:mac": "node scripts/build-mac.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@anthropic-ai/sdk": "0.133.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "ag-psd": "31.0.3",
    "electron-updater": "6.8.9",
    "fflate": "0.8.2",
    "fontkit": "2.0.4",
    "gsap": "3.14.2",
    "hyperframes": "0.8.157",
    "isomorphic-git": "1.44.2",
    "node-pty": "1.1.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "acorn": "8.14.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "js-yaml": "4.3.2",
    "lucide-react": "1.56.0",
    "playwright-core": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  }
}
